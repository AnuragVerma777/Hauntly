# ==============================================================================
# Hauntly Supabase Client Configuration
# ==============================================================================
# ⚠️ SECURITY NOTICE:
# - Only client-safe variables (VITE_*) belong here.
# - NEVER put your Supabase service_role key or OAuth client secrets in frontend code.
# - Google and Apple OAuth Client Secrets are configured exclusively within your
#   Supabase Dashboard (Authentication -> Providers), never in this file.
# ==============================================================================

# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Project Anon / Public Key (safe for browsers)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
